# Copie este arquivo para ".env" (que NÃO é versionado) e troque os valores.

# Senha do usuário "sa" do SQL Server (mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo).
SQL_SA_PASSWORD=TroqueEstaSenha_123

# Chave de assinatura dos tokens JWT (use um texto longo e aleatório, com 32+ caracteres).
JWT_GENERATION_KEY=troque-por-uma-chave-longa-e-aleatoria-com-32-caracteres-ou-mais

# Licença do MediatR (obtida em https://www.luckypennysoftware.com).
LUCKYPENNY_LICENSE_KEY=
